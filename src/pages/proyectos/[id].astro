---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import BrandIcon from '../../components/BrandIcon.astro';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ExternalLink from '@lucide/astro/icons/external-link';
import Lock from '@lucide/astro/icons/lock';
import { getProjects, plainText, projectTags, resolveImage, tagLabel, type Project } from '../../lib/projects';
import { profile } from '../../data/profile';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length]!,
      next: projects[(i + 1) % projects.length]!,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}

const { project, prev, next } = Astro.props;
const images = await Promise.all(project.images.map(resolveImage));
const thumbnail = await resolveImage(project.thumbnail);
const tags = projectTags(project);

const facts = [
  { label: 'Categoría', value: project.category },
  { label: 'Tipo', value: project.purpose },
  { label: 'Fecha', value: project.date },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: plainText(project.description, 300),
  dateCreated: project.date,
  author: { '@type': 'Person', name: profile.name, url: profile.siteUrl },
  keywords: project.technologies.join(', '),
  ...(project.demo ? { url: project.demo } : {}),
};
---

<Base
  title={`${project.title} · ${profile.shortName}`}
  description={plainText(project.description)}
  image={thumbnail}
  type="article"
  jsonLd={jsonLd}
>
  <div class="container-page pt-6 sm:pt-8">
    <a href="/#proyectos" class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-muted transition-colors hover:text-fg">
      <ArrowLeft size={16} aria-hidden="true" /> Todos los proyectos
    </a>

    <header class="mt-4 mb-8 max-w-3xl">
      <div class="flex flex-wrap gap-1.5">
        {tags.map((t) => <span class="chip chip-accent">{tagLabel(t)}</span>)}
      </div>
      <h1 class="mt-4 text-3xl leading-tight font-bold tracking-[-0.03em] sm:text-5xl">{project.title}</h1>
    </header>

    <div class="layout grid gap-6 lg:gap-8">
      <div class="area-gallery min-w-0">
        <Gallery images={images} title={project.title} />
      </div>

      <aside class="area-info">
        <div class="tile lg:sticky lg:top-24">
          <div class="grid gap-4">
            <dl class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-1">
              {
                facts.map((f) => (
                  <div>
                    <dt class="tile-label">{f.label}</dt>
                    <dd class="mt-1 font-medium">{f.value}</dd>
                  </div>
                ))
              }
            </dl>
            <dl>
              <dt class="tile-label">Tecnologías</dt>
              <dd class="mt-2 flex flex-wrap gap-1.5">
                {project.technologies.map((t) => <span class="chip">{t}</span>)}
              </dd>
            </dl>
          </div>

          <div class="mt-6 grid gap-2.5">
            {
              project.demo && (
                <a href={project.demo} class="btn btn-primary w-full" target="_blank" rel="noopener">
                  <ExternalLink size={17} aria-hidden="true" /> Abrir Página Web
                </a>
              )
            }
            {
              project.url && !project.private && (
                <a href={project.url} class={`btn w-full ${project.demo ? 'btn-ghost' : 'btn-primary'}`} target="_blank" rel="noopener">
                  <BrandIcon name="github" size={17} /> Ver código en GitHub
                </a>
              )
            }
            {
              project.private && (
                <p class="flex items-center justify-center gap-2 rounded-full bg-surface-2 px-4 py-3 text-sm text-muted">
                  <Lock size={15} aria-hidden="true" /> Repositorio privado
                </p>
              )
            }
          </div>
        </div>
      </aside>

      <article class="area-desc">
        <h2 class="mb-4 text-xl font-semibold tracking-tight">Sobre el proyecto</h2>
        <div class="prose-project max-w-[68ch] text-[1.0625rem]" set:html={project.description} />
      </article>
    </div>

    <nav class="mt-16 grid gap-3 sm:grid-cols-2" aria-label="Otros proyectos">
      <a href={`/proyectos/${prev.id}/`} class="tile tile-link flex flex-col gap-1">
        <span class="tile-label"><ArrowLeft size={14} aria-hidden="true" /> Anterior</span>
        <span class="font-semibold">{prev.title}</span>
      </a>
      <a href={`/proyectos/${next.id}/`} class="tile tile-link flex flex-col gap-1 sm:items-end sm:text-right">
        <span class="tile-label">Siguiente <ArrowRight size={14} aria-hidden="true" /></span>
        <span class="font-semibold">{next.title}</span>
      </a>
    </nav>
  </div>
</Base>

<style>
  /* Móvil: galería, ficha (con los enlaces) y descripción.
     Escritorio: galería y descripción a la izquierda, ficha fija a la derecha. */
  .layout {
    grid-template-areas: 'gallery' 'info' 'desc';
  }
  @media (min-width: 1024px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 22rem;
      grid-template-areas: 'gallery info' 'desc info';
      align-items: start;
    }
  }
  .area-gallery {
    grid-area: gallery;
  }
  .area-info {
    grid-area: info;
    align-self: stretch;
  }
  .area-desc {
    grid-area: desc;
  }
</style>
