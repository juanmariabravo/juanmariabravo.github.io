---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import ZoomIn from '@lucide/astro/icons/zoom-in';
import X from '@lucide/astro/icons/x';

interface Props {
  images: ImageMetadata[];
  title: string;
}

const { images, title } = Astro.props;

// Versión grande para el visor a pantalla completa
const fullSize = await Promise.all(
  images.map((img) => getImage({ src: img, width: Math.min(img.width, 1800), format: 'webp' })),
);
---

<div class="gallery" data-gallery>
  <div class="relative">
    <ul class="track" data-track aria-label={`Capturas de ${title}`}>
      {
        images.map((img, i) => (
          <li class="slide" data-slide>
            <button type="button" class="slide-btn" data-open={i} aria-label={`Ampliar captura ${i + 1} de ${images.length}`}>
              <Picture
                src={img}
                formats={['avif']} fallbackFormat="webp"
                widths={[480, 800, 1200, 1600, 1920]}
                sizes="(min-width: 1024px) 800px, 100vw"
                alt={`${title} — captura ${i + 1} de ${images.length}`}
                loading={i === 0 ? 'eager' : 'lazy'}
                class="size-full object-contain"
              />
            </button>
          </li>
        ))
      }
    </ul>

    {
      images.length > 1 && (
        <>
          <button type="button" class="nav nav-prev" data-prev aria-label="Captura anterior">
            <ChevronLeft size={20} aria-hidden="true" />
          </button>
          <button type="button" class="nav nav-next" data-next aria-label="Captura siguiente">
            <ChevronRight size={20} aria-hidden="true" />
          </button>
        </>
      )
    }
  </div>

  <div class="mt-3 flex items-center justify-between gap-3 text-sm text-muted">
    <span class="inline-flex items-center gap-1.5"><ZoomIn size={15} aria-hidden="true" /> Pulsa para ampliar</span>
    {
      images.length > 1 && (
        <div class="flex items-center" data-dots>
          {images.map((_, i) => (
            <button type="button" class="dot" data-goto={i} aria-label={`Ir a la captura ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'} />
          ))}
        </div>
      )
    }
  </div>

  <dialog class="lightbox" data-lightbox aria-label={`Visor de capturas de ${title}`}>
    <img data-lightbox-img alt="" />
    <p class="counter" data-counter></p>
    <button type="button" class="lb-btn lb-close" data-close aria-label="Cerrar visor">
      <X size={22} aria-hidden="true" />
    </button>
    {
      images.length > 1 && (
        <>
          <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Captura anterior">
            <ChevronLeft size={24} aria-hidden="true" />
          </button>
          <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Captura siguiente">
            <ChevronRight size={24} aria-hidden="true" />
          </button>
        </>
      )
    }
  </dialog>

  <script is:inline type="application/json" data-sources set:html={JSON.stringify(fullSize.map((f, i) => ({ src: f.src, alt: `${title} — captura ${i + 1} de ${images.length}` })))} />
</div>

<style>
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    border-radius: var(--radius-tile);
    border: 1px solid var(--border);
    background: var(--surface-2);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    aspect-ratio: 16 / 10;
  }
  .slide-btn {
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }
  .slide-btn:focus-visible {
    outline-offset: -4px;
  }
  .nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: #fff;
    background: rgb(0 0 0 / 0.5);
    backdrop-filter: blur(6px);
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }
  .nav:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .nav:disabled {
    opacity: 0;
    pointer-events: none;
  }
  .nav-prev {
    left: 0.75rem;
  }
  .nav-next {
    right: 0.75rem;
  }
  @media (hover: none) {
    .nav {
      display: none;
    }
  }
  /* Botón de 24px (área táctil accesible) con el punto visible dibujado dentro */
  .dot {
    display: grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
  }
  .dot::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--border-strong);
    transition: width 0.25s ease, background-color 0.25s ease;
  }
  .dot[aria-current='true']::before {
    width: 1.4rem;
    background: var(--accent);
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(4 6 9 / 0.96);
    color: #fff;
    overscroll-behavior: contain;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: lb-in 0.2s ease-out;
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lightbox img {
    max-width: calc(100vw - 2rem);
    max-height: calc(100dvh - 7rem);
    object-fit: contain;
    border-radius: 0.5rem;
    touch-action: pan-y pinch-zoom;
  }
  .counter {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    translate: -50% 0;
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.75);
  }
  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    color: #fff;
    background: rgb(255 255 255 / 0.1);
    transition: background-color 0.2s ease;
  }
  .lb-btn:hover {
    background: rgb(255 255 255 / 0.22);
  }
  .lb-close {
    top: 1rem;
    right: 1rem;
  }
  .lb-prev {
    left: 1rem;
    top: 50%;
    translate: 0 -50%;
  }
  .lb-next {
    right: 1rem;
    top: 50%;
    translate: 0 -50%;
  }
  @media (max-width: 639px) {
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 0.5rem;
      translate: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...gallery.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...gallery.querySelectorAll<HTMLButtonElement>('[data-goto]')];
    const prev = gallery.querySelector<HTMLButtonElement>('[data-prev]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-next]');
    const sources: { src: string; alt: string }[] = JSON.parse(
      gallery.querySelector('[data-sources]')?.textContent ?? '[]',
    );

    // ----- Carrusel -----
    let current = 0;
    const goTo = (i: number) => {
      const index = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: slides[index]!.offsetLeft, behavior: 'smooth' });
    };
    const update = () => {
      current = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === current)));
      if (prev) prev.disabled = current === 0;
      if (next) next.disabled = current === slides.length - 1;
    };
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    prev?.addEventListener('click', () => goTo(current - 1));
    next?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
    update();

    // ----- Visor a pantalla completa -----
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-counter]')!;
    let lbIndex = 0;

    const show = (i: number) => {
      lbIndex = (i + sources.length) % sources.length;
      img.src = sources[lbIndex]!.src;
      img.alt = sources[lbIndex]!.alt;
      counter.textContent = `${lbIndex + 1} / ${sources.length}`;
    };

    gallery.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        show(Number(btn.dataset.open));
        dialog.showModal();
      });
    });
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(lbIndex - 1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => show(lbIndex + 1));
    // Clic en el fondo (fuera de la imagen y botones) cierra
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(lbIndex - 1);
      if (e.key === 'ArrowRight') show(lbIndex + 1);
    });
    // Deslizar en móvil
    let startX = 0;
    img.addEventListener('touchstart', (e) => (startX = e.touches[0]!.clientX), { passive: true });
    img.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0]!.clientX - startX;
        if (Math.abs(dx) > 50) show(lbIndex + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
    // Al cerrar, el carrusel queda en la imagen vista
    dialog.addEventListener('close', () => goTo(lbIndex));
  });
</script>
