---
import { Picture } from 'astro:assets';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { projectTags, resolveImage, type Project } from '../lib/projects';

interface Props {
  project: Project;
  /** Las primeras tarjetas se cargan sin lazy para no retrasar lo visible */
  eager?: boolean;
  maxTags?: number;
  /** Nivel del título según la jerarquía de la página */
  headingLevel?: 2 | 3;
}

const { project, eager = false, maxTags = 4, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const image = await resolveImage(project.thumbnail);
const tags = projectTags(project);
const visible = project.technologies.slice(0, maxTags);
const hidden = project.technologies.slice(maxTags);
---

<article class="tile tile-link project-card flex h-full flex-col p-0!" data-tags={tags.join(' ')}>
  <div class="relative aspect-[16/10] overflow-hidden border-b border-line bg-surface-2">
    <Picture
      src={image}
      formats={['avif']} fallbackFormat="webp"
      widths={[400, 640, 960, 1280]}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      class="card-img size-full object-cover object-top"
    />
    {
      project.demo && (
        <span class="absolute top-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-success px-2.5 py-1 text-xs font-semibold text-white shadow dark:text-black">
          <span class="size-1.5 rounded-full bg-current" aria-hidden="true" /> Web Pública
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <p class="text-xs font-medium tracking-wide text-muted uppercase">{project.category} · {project.date}</p>
    <Heading class="text-lg leading-snug font-semibold tracking-tight">
      <a href={`/proyectos/${project.id}/`} class="card-link after:absolute after:inset-0 after:content-['']">
        {project.title}
      </a>
    </Heading>
    <ul class="mt-auto flex flex-wrap gap-1.5 sm:pr-7" aria-label="Tecnologías">
      {visible.map((t) => <li class="chip text-xs!">{t}</li>)}
      {hidden.length > 0 && <li class="chip text-xs!" title={hidden.join(', ')}>+{hidden.length}</li>}
    </ul>
  </div>
  <span class="arrow pointer-events-none absolute right-4 bottom-4 hidden text-muted sm:block" aria-hidden="true">
    <ArrowUpRight size={18} />
  </span>
</article>

<style>
  .card-img {
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .project-card:hover .card-img {
    transform: scale(1.035);
  }
  .project-card:hover .card-link,
  .card-link:focus-visible {
    color: var(--accent-text);
  }
  .card-link:focus-visible {
    outline: none;
  }
  .project-card:has(.card-link:focus-visible) {
    outline: 3px solid color-mix(in srgb, var(--accent), transparent 35%);
    outline-offset: 3px;
  }
  .arrow {
    transition: transform 0.25s ease, color 0.25s ease;
  }
  .project-card:hover .arrow {
    color: var(--accent-text);
    transform: translate(2px, -2px);
  }
</style>
